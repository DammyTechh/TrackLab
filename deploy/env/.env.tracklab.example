# Institution A. Copy to deploy/env/.env.tracklab (gitignored) and fill in.
#   npm run dev        -> uses this file
#   npm run build:tracklab -> uses this file
VITE_INSTITUTION_CODE=TRACKLAB
VITE_INSTITUTION_NAME=Federal University ___
VITE_PRODUCT_NAME=TrackLAB
# Quote the hex values: an unquoted # starts a comment in a dotenv file
# and the colour silently parses as empty.
VITE_BRAND_PRIMARY="#0b4a28"
VITE_BRAND_ACCENT="#e8b93f"
VITE_BRAND_LOGO_URL=/brand/tracklab-lockup.png
VITE_TIMEZONE=Africa/Lagos
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Local development: VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=

# Optional. Leave unset on Supabase Cloud: the probe derives it from
# VITE_SUPABASE_URL. Set it only for an on-premise host with its own check.
# VITE_HEALTH_URL=

# The permanent public address printed into every QR label, e.g.
# https://app.tracklab.edu.ng  Labels are printed once, so set this
# before printing any. Without it, labels point at whatever address the
# printing browser is on (localhost while developing).
VITE_PUBLIC_BASE_URL=

# Optional. Web Push public key from `npx web-push generate-vapid-keys`.
# The private half is a Supabase function secret, never here. Without this
# the "Turn on notifications" option is hidden; alerts still show in-app.
# VITE_VAPID_PUBLIC_KEY=
