# EvidenceTag on-premise settings. Copy to .env.onprem (gitignored), fill in,
# then run ./setup.sh. This file is the source of truth: setup.sh re-applies
# it to the Supabase .env on every run.

# The one hostname, used on the campus LAN and through the tunnel alike.
# Campus DNS (router or Pi-hole) points it at this server's LAN IP; public
# DNS points it at Cloudflare. The printed QR codes contain this name.
DOMAIN=app.tracklab.edu.ng

# Let's Encrypt account email (expiry notices).
ACME_EMAIL=it.admin@tracklab.edu.ng

# Cloudflare API token with Zone:DNS:Edit on the institution's zone. Caddy
# uses it for the DNS challenge, which is what lets the certificate be issued
# for a server Let's Encrypt cannot reach directly.
CLOUDFLARE_API_TOKEN=

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> your tunnel).
# Leave empty for LAN-only. Public hostname route: https://caddy:443 with
# "Origin Server Name" set to the DOMAIN above.
CLOUDFLARE_TUNNEL_TOKEN=

# Edge function secrets. Email and push need internet; on a LAN-only day
# alerts wait in the outbox and the in-app list keeps working.
RESEND_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Backups (backup.sh). An external drive, and somewhere off-site.
BACKUP_DIR=/mnt/backup/evidencetag
BACKUP_KEEP_DAYS=14
# e.g. backup@offsite.example:/srv/evidencetag   (rsync over SSH; leave empty to skip)
OFFSITE_RSYNC_TARGET=
