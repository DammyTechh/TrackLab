# Dependencies and build output
node_modules
dist
dist-ssr
dev-dist
*.tsbuildinfo
*.local
.DS_Store

# Supabase CLI working files. `supabase start` writes the local keys into
# .temp, so it must never be committed.
supabase/.temp/
supabase/.branches/
supabase-start-debug.txt
docker.env

# Never commit either institution's real configuration or its seed list.
.env
.env.*
!.env.example
deploy/env/.env.*
!deploy/env/.env.*.example
supabase/seed/users.*.json
!supabase/seed/users.example.json

# End-to-end build output and reports
/dist-e2e/
/test-results/
/playwright-report/

# Institution repositories generated by `npm run export`
/exports/
